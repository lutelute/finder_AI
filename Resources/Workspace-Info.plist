	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/lutelute/finder_AI/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>4kGI371BiHpXUHG4O9UEc+E/1dIrdG4a/H5P8TIUJy4=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
